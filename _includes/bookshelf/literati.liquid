{% assign books_by_year = site.books | group_by: 'year' | sort: 'name' | reverse %}
{% assign recommended_books = site.books | where: 'recommended', true %}
{% assign featured_books = recommended_books %}
{% if featured_books.size == 0 %}
  {% assign featured_books = site.books | sort: 'year' | reverse | slice: 0, 4 %}
{% endif %}
{% assign categories = site.books | map: 'category' | uniq %}
{% assign latest_year = books_by_year.first.name %}

<style>
  html.page-bookshelf,
  body.page-bookshelf {
    background: #070a0f;
    color: #dde3df;
    color-scheme: dark;
  }

  body.page-bookshelf {
    --global-bg-color: #070a0f;
    --global-card-bg-color: #0f171d;
    --global-divider-color: rgba(151, 177, 176, 0.18);
    --global-hover-text-color: #071014;
    --global-text-color: #dde3df;
    --global-text-color-light: #9ba9aa;
    --global-theme-color: #c8ad6d;
  }

  body.page-bookshelf #navbar {
    border-bottom: 1px solid rgba(151, 177, 176, 0.14);
    background: rgba(7, 10, 15, 0.92);
    backdrop-filter: blur(12px);
  }

  body.page-bookshelf .post-header .post-title {
    color: #edf0e9;
  }

  .literati-bookshelf,
  .literati-modal {
    --lr-paper: #081015;
    --lr-paper-soft: #0f171d;
    --lr-ink: #e5e9e3;
    --lr-muted: #9ba9aa;
    --lr-line: rgba(151, 177, 176, 0.17);
    --lr-line-strong: rgba(184, 201, 197, 0.3);
    --lr-cinnabar: #b96c61;
    --lr-jade: #6f9b91;
    --lr-indigo: #7c9fab;
    --lr-gold: #c8ad6d;
    --lr-shadow: 0 22px 60px rgba(0, 0, 0, 0.38);
    --lr-serif: 'LXGW WenKai', 'Songti SC', 'STSong', 'Noto Serif CJK SC', 'Source Han Serif SC', Georgia, serif;
    --lr-sans: 'Inter', 'Avenir Next', 'PingFang SC', 'Microsoft YaHei', Arial, sans-serif;
    position: relative;
    margin: 1.5rem 0 3rem;
    padding: 0 0 1rem;
    color: var(--lr-ink);
    font-family: var(--lr-sans);
    isolation: isolate;
  }

  html[data-theme='dark'] .literati-bookshelf,
  html[data-theme='dark'] .literati-modal {
    --lr-paper: #060b0f;
    --lr-paper-soft: #0c141a;
    --lr-ink: #e7eae4;
    --lr-muted: #a0adae;
    --lr-line: rgba(151, 177, 176, 0.16);
    --lr-line-strong: rgba(184, 201, 197, 0.28);
    --lr-shadow: 0 22px 60px rgba(0, 0, 0, 0.46);
  }

  .literati-bookshelf *,
  .literati-bookshelf *::before,
  .literati-bookshelf *::after {
    box-sizing: border-box;
  }

  .literati-bookshelf::before {
    content: '';
    position: absolute;
    inset: -1.5rem calc(50% - 50vw) -3rem;
    z-index: -2;
    background:
      linear-gradient(90deg, rgba(124, 159, 171, 0.045) 1px, transparent 1px) 0 0 / 40px 40px,
      linear-gradient(0deg, rgba(200, 173, 109, 0.035) 1px, transparent 1px) 0 0 / 40px 40px,
      linear-gradient(145deg, #081117 0%, #0b1118 45%, #070a0f 100%);
  }

  .literati-bookshelf::after {
    content: '';
    position: absolute;
    inset: -1.5rem calc(50% - 50vw) -3rem;
    z-index: -1;
    pointer-events: none;
    opacity: 0.34;
    background:
      repeating-linear-gradient(90deg, rgba(174, 194, 191, 0.035) 0 1px, transparent 1px 9px),
      repeating-linear-gradient(0deg, rgba(255, 255, 255, 0.025) 0 1px, transparent 1px 8px);
    mix-blend-mode: screen;
  }

  html[data-theme='dark'] .literati-bookshelf::after {
    opacity: 0.28;
    mix-blend-mode: screen;
  }

  .literati-hero {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(260px, 0.65fr);
    gap: 1.4rem;
    align-items: stretch;
    margin: 0 0 1.6rem;
    padding: 1.5rem;
    border: 1px solid var(--lr-line);
    background:
      linear-gradient(135deg, rgba(17, 27, 34, 0.96), rgba(8, 14, 19, 0.9)), linear-gradient(90deg, rgba(200, 173, 109, 0.1), transparent 42%);
    box-shadow: var(--lr-shadow);
  }

  html[data-theme='dark'] .literati-hero {
    background:
      linear-gradient(135deg, rgba(14, 23, 29, 0.98), rgba(6, 11, 15, 0.94)), linear-gradient(90deg, rgba(200, 173, 109, 0.09), transparent 42%);
  }

  .literati-hero-copy {
    min-width: 0;
    display: grid;
    align-content: center;
    gap: 0.8rem;
    padding: 0.4rem 0;
  }

  .literati-hero h2 {
    max-width: 17em;
    margin: 0;
    color: var(--lr-ink);
    font-family: var(--lr-serif);
    font-size: 2.15rem;
    font-weight: 600;
    line-height: 1.22;
    text-shadow: 0 2px 24px rgba(200, 173, 109, 0.08);
  }

  .literati-hero p {
    max-width: 44rem;
    margin: 0;
    color: var(--lr-muted);
    font-size: 1rem;
    line-height: 1.8;
  }

  .literati-hero-cite {
    color: var(--lr-gold);
    font-family: var(--lr-serif);
    font-size: 0.95rem;
    font-style: normal;
  }

  .literati-hero-aside {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 100%;
    overflow: hidden;
    padding: 1.15rem;
    border: 1px solid var(--lr-line);
    background: rgba(5, 10, 14, 0.72);
  }

  html[data-theme='dark'] .literati-hero-aside {
    background: rgba(3, 7, 10, 0.76);
  }

  .literati-hero-image {
    width: min(100%, 18rem);
    margin: 0;
  }

  .literati-hero-image img {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid rgba(200, 173, 109, 0.22);
    border-radius: 6px;
    box-shadow:
      0 20px 44px rgba(0, 0, 0, 0.46),
      0 0 32px rgba(200, 173, 109, 0.08);
  }

  .literati-section-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 1rem;
    margin: 2rem 0 1rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--lr-line);
  }

  .literati-section-heading h3 {
    margin: 0;
    color: var(--lr-ink);
    font-family: var(--lr-serif);
    font-size: 1.45rem;
    font-weight: 600;
    line-height: 1.25;
  }

  .literati-section-heading span,
  .literati-section-heading small {
    color: var(--lr-muted);
    font-size: 0.84rem;
  }

  .literati-feature-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1rem;
  }

  .literati-feature-card,
  .literati-book-card {
    appearance: none;
    width: 100%;
    min-width: 0;
    border: 1px solid var(--lr-line);
    border-radius: 0;
    color: inherit;
    font: inherit;
    text-align: left;
    cursor: pointer;
    transition:
      transform 180ms ease,
      border-color 180ms ease,
      box-shadow 180ms ease,
      background-color 180ms ease;
  }

  .literati-feature-card {
    display: grid;
    grid-template-columns: 84px minmax(0, 1fr);
    gap: 0.9rem;
    align-items: center;
    min-height: 152px;
    padding: 0.9rem;
    background:
      linear-gradient(180deg, rgba(16, 25, 32, 0.94), rgba(10, 17, 22, 0.9)), linear-gradient(90deg, rgba(200, 173, 109, 0.08), transparent);
  }

  html[data-theme='dark'] .literati-feature-card {
    background:
      linear-gradient(180deg, rgba(14, 23, 29, 0.96), rgba(8, 14, 19, 0.92)), linear-gradient(90deg, rgba(200, 173, 109, 0.07), transparent);
  }

  .literati-feature-card:hover,
  .literati-book-card:hover,
  .literati-feature-card:focus-visible,
  .literati-book-card:focus-visible {
    border-color: var(--accent, var(--lr-cinnabar));
    box-shadow: 0 16px 34px rgba(0, 0, 0, 0.36);
    outline: none;
    transform: translateY(-3px);
  }

  html[data-theme='dark'] .literati-feature-card:hover,
  html[data-theme='dark'] .literati-book-card:hover,
  html[data-theme='dark'] .literati-feature-card:focus-visible,
  html[data-theme='dark'] .literati-book-card:focus-visible {
    box-shadow: 0 14px 28px rgba(0, 0, 0, 0.34);
  }

  .literati-feature-cover,
  .literati-book-cover {
    position: relative;
    overflow: hidden;
    background: #172127;
    box-shadow: 0 12px 24px rgba(0, 0, 0, 0.38);
  }

  .literati-feature-cover {
    width: 84px;
    aspect-ratio: 2 / 3;
  }

  .literati-book-cover {
    width: 62px;
    aspect-ratio: 2 / 3;
    flex: 0 0 62px;
  }

  .literati-feature-cover img,
  .literati-book-cover img,
  .literati-modal-cover img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .literati-feature-copy,
  .literati-book-copy {
    min-width: 0;
  }

  .literati-book-eyebrow {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    align-items: center;
    margin-bottom: 0.45rem;
    color: var(--lr-muted);
    font-size: 0.75rem;
    line-height: 1.35;
  }

  .literati-book-eyebrow::before {
    content: '';
    width: 0.55rem;
    height: 0.55rem;
    border: 1px solid var(--accent, var(--lr-cinnabar));
    background: color-mix(in srgb, var(--accent, var(--lr-cinnabar)) 24%, transparent);
  }

  .literati-feature-title,
  .literati-book-title {
    display: block;
    color: var(--lr-ink);
    font-family: var(--lr-serif);
    font-weight: 600;
    line-height: 1.35;
  }

  .literati-feature-title {
    font-size: 1.05rem;
  }

  .literati-book-title {
    font-size: 0.98rem;
  }

  .literati-feature-desc,
  .literati-book-desc {
    display: block;
    margin-top: 0.42rem;
    color: var(--lr-muted);
    font-size: 0.82rem;
    line-height: 1.55;
  }

  .literati-years {
    display: grid;
    gap: 1rem;
  }

  .literati-year-band {
    display: grid;
    grid-template-columns: 116px minmax(0, 1fr);
    gap: 1rem;
    padding: 1rem 0;
    border-bottom: 1px solid var(--lr-line);
  }

  .literati-year-marker {
    position: sticky;
    top: 5.2rem;
    align-self: start;
    display: grid;
    gap: 0.45rem;
    padding: 0.1rem 0 0.9rem;
    color: var(--lr-muted);
  }

  .literati-year-marker strong {
    color: var(--lr-cinnabar);
    font-family: var(--lr-serif);
    font-size: 1.55rem;
    font-weight: 600;
    line-height: 1;
  }

  .literati-year-marker span {
    font-size: 0.8rem;
  }

  .literati-year-marker::after {
    content: '';
    width: 1px;
    height: 4.2rem;
    background: linear-gradient(var(--lr-cinnabar), transparent);
  }

  .literati-book-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.75rem;
  }

  .literati-book-card {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    min-height: 124px;
    padding: 0.72rem;
    background: linear-gradient(90deg, color-mix(in srgb, var(--accent, var(--lr-jade)) 9%, transparent), transparent 38%), rgba(13, 22, 28, 0.9);
  }

  html[data-theme='dark'] .literati-book-card {
    background: linear-gradient(90deg, color-mix(in srgb, var(--accent, var(--lr-jade)) 10%, transparent), transparent 38%), rgba(9, 16, 21, 0.94);
  }

  .literati-modal {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: grid;
    place-items: center;
    padding: 1.2rem;
    background: rgba(2, 5, 8, 0.76);
    backdrop-filter: blur(5px);
    opacity: 0;
    pointer-events: none;
    transition: opacity 180ms ease;
  }

  .literati-modal.is-open {
    opacity: 1;
    pointer-events: auto;
  }

  body.literati-modal-open {
    overflow: hidden;
  }

  .literati-modal-panel {
    position: relative;
    display: grid;
    grid-template-columns: 168px minmax(0, 1fr);
    gap: 1.2rem;
    width: min(720px, 100%);
    max-height: min(86vh, 680px);
    overflow: auto;
    padding: 1.25rem;
    border: 1px solid var(--lr-line-strong);
    background-color: var(--lr-paper-soft);
    background-image:
      linear-gradient(90deg, rgba(200, 173, 109, 0.08), transparent 34%),
      repeating-linear-gradient(90deg, rgba(151, 177, 176, 0.035) 0 1px, transparent 1px 10px);
    box-shadow: 0 26px 70px rgba(0, 0, 0, 0.58);
    transform: translateY(10px);
    transition: transform 180ms ease;
  }

  html[data-theme='dark'] .literati-modal-panel {
    background-color: var(--lr-paper-soft);
    background-image:
      linear-gradient(90deg, rgba(200, 173, 109, 0.07), transparent 34%),
      repeating-linear-gradient(90deg, rgba(151, 177, 176, 0.035) 0 1px, transparent 1px 10px);
  }

  .literati-modal.is-open .literati-modal-panel {
    transform: translateY(0);
  }

  .literati-modal-cover {
    width: 168px;
    aspect-ratio: 2 / 3;
    overflow: hidden;
    background: #172127;
    box-shadow: 0 18px 36px rgba(0, 0, 0, 0.48);
  }

  .literati-modal-copy {
    min-width: 0;
    display: grid;
    align-content: start;
    gap: 0.75rem;
    padding-right: 2.4rem;
  }

  .literati-modal-meta {
    margin: 0;
    color: var(--modal-accent, var(--lr-cinnabar));
    font-size: 0.84rem;
    font-weight: 700;
  }

  .literati-modal-title {
    margin: 0;
    color: var(--lr-ink);
    font-family: var(--lr-serif);
    font-size: 1.8rem;
    font-weight: 600;
    line-height: 1.25;
  }

  .literati-modal-desc {
    margin: 0;
    color: var(--lr-muted);
    font-size: 1rem;
    line-height: 1.8;
  }

  .literati-modal-link {
    display: inline-flex;
    width: fit-content;
    align-items: center;
    justify-content: center;
    min-height: 2.5rem;
    margin-top: 0.35rem;
    padding: 0.55rem 0.9rem;
    border: 1px solid var(--modal-accent, var(--lr-cinnabar));
    color: var(--modal-accent, var(--lr-cinnabar));
    font-size: 0.9rem;
    font-weight: 700;
    text-decoration: none;
  }

  .literati-modal-link:hover {
    background: color-mix(in srgb, var(--modal-accent, var(--lr-cinnabar)) 12%, transparent);
    color: var(--modal-accent, var(--lr-cinnabar));
    text-decoration: none;
  }

  .literati-modal-close {
    position: absolute;
    top: 0.8rem;
    right: 0.8rem;
    display: grid;
    place-items: center;
    width: 2.2rem;
    height: 2.2rem;
    border: 1px solid var(--lr-line-strong);
    border-radius: 0;
    background: rgba(12, 20, 26, 0.9);
    color: var(--lr-ink);
    font-size: 1.3rem;
    line-height: 1;
    cursor: pointer;
  }

  html[data-theme='dark'] .literati-modal-close {
    background: rgba(8, 14, 19, 0.94);
  }

  .literati-modal-close:focus-visible,
  .literati-modal-close:hover {
    border-color: var(--modal-accent, var(--lr-cinnabar));
    outline: none;
  }

  @media (max-width: 1100px) {
    .literati-feature-grid,
    .literati-book-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 760px) {
    .literati-bookshelf {
      margin-top: 1rem;
    }

    .literati-hero,
    .literati-year-band,
    .literati-modal-panel {
      grid-template-columns: 1fr;
    }

    .literati-hero {
      padding: 1rem;
    }

    .literati-hero h2 {
      font-size: 1.72rem;
    }

    .literati-hero-image {
      width: min(100%, 16rem);
    }

    .literati-feature-grid,
    .literati-book-grid {
      grid-template-columns: 1fr;
    }

    .literati-year-marker {
      position: static;
      grid-template-columns: auto 1fr;
      align-items: center;
      padding-bottom: 0;
    }

    .literati-year-marker::after {
      width: 100%;
      height: 1px;
      background: linear-gradient(90deg, var(--lr-cinnabar), transparent);
    }

    .literati-modal-cover {
      width: 132px;
    }

    .literati-modal-copy {
      padding-right: 0;
    }

    .literati-modal-title {
      font-size: 1.42rem;
    }
  }

  @media (max-width: 460px) {
    .literati-feature-card,
    .literati-book-card {
      grid-template-columns: 70px minmax(0, 1fr);
      gap: 0.7rem;
    }

    .literati-feature-card {
      min-height: 136px;
    }

    .literati-feature-cover {
      width: 70px;
    }

    .literati-book-cover {
      width: 54px;
      flex-basis: 54px;
    }

    .literati-section-heading {
      align-items: start;
      flex-direction: column;
      gap: 0.35rem;
    }
  }
</style>

<div class="literati-bookshelf" data-bookshelf-style="literati">
  <section class="literati-hero" aria-labelledby="literati-books-title">
    <div class="literati-hero-copy">
      <h2 id="literati-books-title">The moon is high up in the sky and it's spring.</h2>
      <p>
        I think of you and within myself I'm complete.<br>
        A light breeze comes to me from across the hazy fields.
      </p>
      <cite class="literati-hero-cite">— Fernando Pessoa</cite>
    </div>
    <aside class="literati-hero-aside" aria-label="Moon illustration">
      <figure class="literati-hero-image">
        <img
          src="{{ '/assets/img/book_logo.png' | relative_url }}"
          alt="Crescent moon bookshelf illustration"
          width="1005"
          height="894"
          loading="eager"
          fetchpriority="high"
        >
      </figure>
    </aside>
  </section>

  <section class="literati-featured" aria-labelledby="literati-featured-title">
    <div class="literati-section-heading">
      <div>
        <span>Selected Volumes</span>
        <h3 id="literati-featured-title">案头清供</h3>
      </div>
      <small>{{ featured_books | size }} selected</small>
    </div>

    <div class="literati-feature-grid">
      {% for book in featured_books limit: 4 %}
        {% assign book_url = book.redirect | default: book.url %}
        {% if book_url == '#' or book_url == '' %}
          {% assign book_url = book.url %}
        {% endif %}
        {% assign accent_index = forloop.index0 | modulo: 4 %}
        {% case accent_index %}
          {% when 0 %}
            {% assign book_accent = '#b96c61' %}
          {% when 1 %}
            {% assign book_accent = '#6f9b91' %}
          {% when 2 %}
            {% assign book_accent = '#7c9fab' %}
          {% else %}
            {% assign book_accent = '#c8ad6d' %}
        {% endcase %}
        <button
          class="literati-feature-card literati-book-trigger"
          type="button"
          style="--accent: {{ book_accent }};"
          data-title="{{ book.title | escape }}"
          data-desc="{{ book.description | strip_html | strip_newlines | escape }}"
          data-img="{{ book.img | relative_url }}"
          data-url="{{ book_url | relative_url }}"
          data-year="{{ book.year | escape }}"
          data-category="{{ book.category | default: 'Book' | escape }}"
          data-accent="{{ book_accent }}"
        >
          <span class="literati-feature-cover">
            <img src="{{ book.img | relative_url }}" alt="{{ book.title | escape }} cover" loading="lazy">
          </span>
          <span class="literati-feature-copy">
            <span class="literati-book-eyebrow">{{ book.year }} · {{ book.category }}</span>
            <span class="literati-feature-title">{{ book.title }}</span>
            <span class="literati-feature-desc">{{ book.description | strip_html | strip_newlines | truncate: 58 }}</span>
          </span>
        </button>
      {% endfor %}
    </div>
  </section>

  <section class="literati-catalog" aria-labelledby="literati-catalog-title">
    <div class="literati-section-heading">
      <div>
        <span>By Year</span>
        <h3 id="literati-catalog-title">岁月书架</h3>
      </div>
      <small>{{ categories | size }} categories</small>
    </div>

    <div class="literati-years">
      {% for year_group in books_by_year %}
        <section class="literati-year-band" aria-labelledby="literati-year-{{ year_group.name }}">
          <div class="literati-year-marker">
            <strong id="literati-year-{{ year_group.name }}">{{ year_group.name }}</strong>
            <span>{{ year_group.items | size }} 卷</span>
          </div>

          <div class="literati-book-grid">
            {% assign sorted_books = year_group.items | sort: 'importance' %}
            {% for book in sorted_books %}
              {% assign book_url = book.redirect | default: book.url %}
              {% if book_url == '#' or book_url == '' %}
                {% assign book_url = book.url %}
              {% endif %}
              {% assign accent_index = forloop.index0 | modulo: 4 %}
              {% case accent_index %}
                {% when 0 %}
                  {% assign book_accent = '#6f9b91' %}
                {% when 1 %}
                  {% assign book_accent = '#b96c61' %}
                {% when 2 %}
                  {% assign book_accent = '#7c9fab' %}
                {% else %}
                  {% assign book_accent = '#c8ad6d' %}
              {% endcase %}
              <button
                class="literati-book-card literati-book-trigger"
                type="button"
                style="--accent: {{ book_accent }};"
                data-title="{{ book.title | escape }}"
                data-desc="{{ book.description | strip_html | strip_newlines | escape }}"
                data-img="{{ book.img | relative_url }}"
                data-url="{{ book_url | relative_url }}"
                data-year="{{ book.year | escape }}"
                data-category="{{ book.category | default: 'Book' | escape }}"
                data-accent="{{ book_accent }}"
              >
                <span class="literati-book-cover">
                  <img src="{{ book.img | relative_url }}" alt="{{ book.title | escape }} cover" loading="lazy">
                </span>
                <span class="literati-book-copy">
                  <span class="literati-book-eyebrow">{{ book.category | default: 'Book' }}</span>
                  <span class="literati-book-title">{{ book.title }}</span>
                  <span class="literati-book-desc">{{ book.description | strip_html | strip_newlines | truncate: 46 }}</span>
                </span>
              </button>
            {% endfor %}
          </div>
        </section>
      {% endfor %}
    </div>
  </section>
</div>

<div class="literati-modal" id="literatiBookModal" aria-hidden="true">
  <div class="literati-modal-panel" role="dialog" aria-modal="true" aria-labelledby="literatiModalTitle">
    <button class="literati-modal-close" type="button" aria-label="Close book detail">&times;</button>
    <div class="literati-modal-cover">
      <img id="literatiModalImg" alt="">
    </div>
    <div class="literati-modal-copy">
      <p class="literati-modal-meta" id="literatiModalMeta"></p>
      <h3 class="literati-modal-title" id="literatiModalTitle"></h3>
      <p class="literati-modal-desc" id="literatiModalDesc"></p>
      <a class="literati-modal-link" id="literatiModalLink" href="#">阅览札记</a>
    </div>
  </div>
</div>

<script>
  (function () {
    const root = document.querySelector('.literati-bookshelf');
    const modal = document.getElementById('literatiBookModal');
    if (!root || !modal) return;

    const triggers = Array.from(root.querySelectorAll('.literati-book-trigger'));
    const panel = modal.querySelector('.literati-modal-panel');
    const closeButton = modal.querySelector('.literati-modal-close');
    const modalTitle = document.getElementById('literatiModalTitle');
    const modalMeta = document.getElementById('literatiModalMeta');
    const modalDesc = document.getElementById('literatiModalDesc');
    const modalImg = document.getElementById('literatiModalImg');
    const modalLink = document.getElementById('literatiModalLink');
    let lastFocused = null;

    function openBook(trigger) {
      lastFocused = document.activeElement;
      const title = trigger.dataset.title || 'Untitled';
      const url = trigger.dataset.url || '#';

      modalTitle.textContent = title;
      modalMeta.textContent = `${trigger.dataset.year || 'Year'} · ${trigger.dataset.category || 'Book'}`;
      modalDesc.textContent = trigger.dataset.desc || 'No note yet.';
      modalImg.src = trigger.dataset.img || '';
      modalImg.alt = `${title} cover`;
      panel.style.setProperty('--modal-accent', trigger.dataset.accent || '#b96c61');

      if (url && url !== '#' && url !== '/#') {
        modalLink.hidden = false;
        modalLink.href = url;
      } else {
        modalLink.hidden = true;
        modalLink.removeAttribute('href');
      }

      modal.classList.add('is-open');
      modal.setAttribute('aria-hidden', 'false');
      document.body.classList.add('literati-modal-open');
      closeButton.focus({ preventScroll: true });
    }

    function closeBook() {
      modal.classList.remove('is-open');
      modal.setAttribute('aria-hidden', 'true');
      document.body.classList.remove('literati-modal-open');
      if (lastFocused && typeof lastFocused.focus === 'function') {
        lastFocused.focus({ preventScroll: true });
      }
    }

    triggers.forEach((trigger) => {
      trigger.addEventListener('click', () => openBook(trigger));
    });

    closeButton.addEventListener('click', closeBook);
    modal.addEventListener('click', (event) => {
      if (event.target === modal) closeBook();
    });
    document.addEventListener('keydown', (event) => {
      if (!modal.classList.contains('is-open')) return;

      if (event.key === 'Escape') {
        closeBook();
        return;
      }

      if (event.key === 'Tab') {
        const focusable = Array.from(panel.querySelectorAll('a[href], button:not([disabled]), [tabindex]:not([tabindex="-1"])')).filter(
          (element) => !element.hidden
        );
        const first = focusable[0];
        const last = focusable[focusable.length - 1];

        if (event.shiftKey && document.activeElement === first) {
          event.preventDefault();
          last.focus();
        } else if (!event.shiftKey && document.activeElement === last) {
          event.preventDefault();
          first.focus();
        }
      }
    });
  })();
</script>
